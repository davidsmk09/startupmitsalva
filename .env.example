# =====================================================================
# KI-Sichtbarkeits-Plattform – Umgebungsvariablen
# Kopiere diese Datei nach `.env` und trage deine Werte ein.
# Ohne externe Keys läuft die App komplett im Mock-/Demo-Modus.
# NIEMALS echte Secrets committen.
# =====================================================================

# --- Datenbank -------------------------------------------------------
# Entwicklung (SQLite, Datei wird automatisch angelegt):
DATABASE_URL="file:./dev.db"
# Produktion (PostgreSQL) – vorher `npm run db:use-postgres` ausführen:
# DATABASE_URL="postgresql://user:passwort@host:5432/datenbank?schema=public"

# --- App / Auth ------------------------------------------------------
# Öffentliche Basis-URL der App (ohne Slash am Ende)
NEXTAUTH_URL="http://localhost:3000"
# Zufälliger, langer Wert: `openssl rand -base64 32`
NEXTAUTH_SECRET="bitte-durch-zufaelligen-wert-ersetzen"
# Produkt-/Projektname (erscheint in UI, E-Mails, PDF, User-Agent)
APP_NAME="KI-Sichtbar"
APP_URL="http://localhost:3000"
# Schützt /api/cron/* (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="bitte-durch-zufaelligen-wert-ersetzen"
# Empfänger für Lead-Benachrichtigungen
ADMIN_NOTIFY_EMAIL="admin@example.com"

# --- Seed ------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="AdminPasswort123!"

# --- Google-Login (optional, nur aktiv wenn beide gesetzt) -----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-Mail ----------------------------------------------------------
# Ohne Key werden E-Mails in der Konsole und in der Tabelle OutboxEmail protokolliert.
RESEND_API_KEY=""
EMAIL_FROM="KI-Sichtbar <noreply@example.com>"

# --- Stripe (NUR Testmodus-Keys: sk_test_..., pk_test_...) ------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- KI-Provider (alle optional; ohne Key -> Mock-Provider) ----------
# Modellnamen veralten regelmäßig – bei Bedarf hier anpassen.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Geschätzte Kosten in US-Cent je 1.000 Tokens (nur für Kostenschätzung/Budget)
OPENAI_COST_PER_1K_CENTS="0.06"
PERPLEXITY_COST_PER_1K_CENTS="0.1"
GEMINI_COST_PER_1K_CENTS="0.04"
ANTHROPIC_COST_PER_1K_CENTS="0.4"

# Sentiment-Analyse & Verifikations-Call (nur wirksam, wenn ein Key vorhanden ist)
SCAN_SENTIMENT_ENABLED="true"
SCAN_VERIFY_ENABLED="false"

# --- Crawler ---------------------------------------------------------
FIRECRAWL_API_KEY=""

# --- Scan-Engine -----------------------------------------------------
# Wiederholungen je Prompt × Provider (Antworten schwanken)
SCAN_RUNS_PER_PROMPT=3
# Fallback-Budget je Organisation und Monat in Cent (wenn der Plan keins definiert)
MONTHLY_BUDGET_CENTS_DEFAULT=2000
# Job-Ausführung: "worker" (separater Prozess `npm run worker`) oder
# "inline" (direkt im Web-Prozess – praktisch für Demos ohne Worker)
JOB_MODE="worker"

# --- Abrechnung / Anzeige --------------------------------------------
# "net" = Preise zzgl. MwSt. (B2B), "gross" = inkl. MwSt.
PRICE_DISPLAY="net"
VAT_RATE_PERCENT=19
