    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
