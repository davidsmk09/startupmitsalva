{
  "name": "ki-sichtbarkeit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx worker/index.ts",
    "seed": "tsx prisma/seed.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "db:use-postgres": "tsx scripts/use-postgres.ts",
    "postinstall": "prisma generate",
    "test:e2e:build": "npm run build && E2E_USE_BUILD=1 playwright test",
    "format": "prettier --write ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.4.0",
